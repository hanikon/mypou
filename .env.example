# Копия этого файла с реальными значениями НЕ коммитится.
# Фронтенд (apps/web/.env.local) — публичные значения, попадают в бандл:
VITE_API_URL=https://your-worker.your-subdomain.workers.dev

# Worker (apps/worker/.dev.vars локально, в Cloudflare — Secrets).
# Появятся на этапе 2:
BOT_TOKEN=
WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BOT_USERNAME=
MINIAPP_SHORT_NAME=
WEB_ORIGIN=https://your-project.pages.dev
