# Шаблон переменных. Реальные значения НЕ коммитятся.

# ── Фронтенд (Cloudflare Pages → Settings → Variables). Публичное, попадает в бандл.
VITE_API_URL=https://kaplya-api.<your-subdomain>.workers.dev

# ── Worker (Cloudflare → Worker → Settings → Variables and Secrets, тип Secret).
#    Локально: apps/worker/.dev.vars (в .gitignore).
BOT_TOKEN=
# Случайная строка 32+ символов, только A-Z a-z 0-9 _ -
WEBHOOK_SECRET=
SUPABASE_URL=https://<project-ref>.supabase.co
# service_role (legacy) или secret key (sb_secret_...). Только для Worker!
SUPABASE_SERVICE_ROLE_KEY=
# Адрес фронтенда без слэша в конце
WEB_ORIGIN=https://<project>.pages.dev
BOT_USERNAME=
MINIAPP_SHORT_NAME=
